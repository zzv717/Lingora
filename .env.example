# ==============================================================================
# Lingora — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production / development:
#   cp .env.example .env
#
# IMPORTANT:
# - In production (ENV=prod or APP_ENV=prod), SECRET_KEY and POSTGRES_PASSWORD
#   MUST be replaced with strong, random strings (min 32 characters for SECRET_KEY).
#   The server will deliberately fail to start if the default placeholder is detected.
# ==============================================================================

# --- Application Environment ---
ENV=dev                                  # dev | prod | test (APP_ENV is also supported)
APP_NAME=Lingora API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiter Trusted Proxies:
# Leave empty to ignore X-Forwarded-For and use direct socket IP.
# If behind Nginx / Cloudflare / Traefik, list trusted proxy IPs/CIDRs, or '*'
TRUSTED_PROXIES=

# --- Database ---
# Local dev: sqlite:///./data/lingora.db
# Docker Compose: postgresql://lingora:your_secure_password@db:5432/lingora
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/lingora.db
POSTGRES_PASSWORD=lingora_dev_password

# --- File Storage ---
# "local" (default disk) or "supabase" (Supabase Storage REST API)
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public/anon key only; used by browsers for path-scoped signed uploads.
SUPABASE_PUBLISHABLE_KEY=
# Enable only after the private bucket has the exact 50 MiB file limit.
SUPABASE_DIRECT_UPLOAD_ENABLED=false
SUPABASE_STORAGE_BUCKET=lingora-books

# --- Upload Limits ---
UPLOAD_MAX_MB=50
MAX_PAGES=300

# --- SMTP (Password Resets) ---
# When SMTP is unconfigured in dev mode, reset links are displayed for testing.
# In prod mode, SMTP is required; reset links are NEVER surfaced in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lingora.app

# --- AI Provider (Provider-Agnostic) ---
# Supported providers:
#   none              -> AI features disabled; returns 503 AI_NOT_CONFIGURED (no fake replies)
#   openai_compatible -> OpenAI, Groq, OpenRouter, vLLM, Ollama (set AI_BASE_URL)
#   anthropic         -> Claude
#   gemini            -> Google Gemini
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_LIMIT=0                   # 0 = unlimited per user per day

# --- Background Task Backend ---
# "inline" -> ThreadPoolExecutor inside API (standalone dev/small instance)
# "celery" -> Celery workers with Redis broker (distributed production)
# "sync"   -> request-bound execution for short jobs; no durable queue
TASK_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
