# ============================================================
# Lingora — root environment example
# Copy: backend/.env  (backend reads it via pydantic-settings)
# NEVER commit real values.
# ============================================================

# --- Core security ---
SECRET_KEY=change-me-openssl-rand-hex-32
ENV=dev

# --- Database ---
# Dev (zero setup):
DATABASE_URL=sqlite:///./data/lingora.db
# Production (Supabase -> Project Settings -> Database -> Pooler connection string):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Storage (uploaded books are PRIVATE) ---
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
# Supabase Storage option (create PRIVATE bucket "lingora-books" first):
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key      # server-only!
# SUPABASE_STORAGE_BUCKET=lingora-books

# --- Upload limits ---
UPLOAD_MAX_MB=50
MAX_PAGES=300

# --- AI provider: choose ONE (or keep AI_PROVIDER=none to run without AI) ---
AI_PROVIDER=none
# AI_PROVIDER=openai_compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# --- or Anthropic:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-sonnet-latest
# --- or Gemini:
# AI_PROVIDER=gemini
# AI_API_KEY=...
# AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_LIMIT=0

# --- Background tasks ---
TASK_BACKEND=inline
# TASK_BACKEND=celery
# REDIS_URL=redis://localhost:6379/0

# --- CORS (frontend origins, comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Plan limits (subscription-ready; MVP is all-free) ---
FREE_MAX_BOOKS=3
PRO_MAX_BOOKS=25
PREMIUM_MAX_BOOKS=100
FREE_AI_CALLS_PER_DAY=20
PRO_AI_CALLS_PER_DAY=300
PREMIUM_AI_CALLS_PER_DAY=2000

# --- SMTP (optional: real password-reset emails) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@lingora.app
FRONTEND_URL=http://localhost:3000

# --- Frontend (only needs the backend URL for its internal proxy) ---
# BACKEND_URL=http://127.0.0.1:8000
