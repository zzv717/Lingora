# Copy of root .env.example for backend standalone development
# Refer to root .env.example for comments and options.
ENV=dev
APP_NAME=Lingora API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
TRUSTED_PROXIES=
DATABASE_URL=sqlite:///./data/lingora.db
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lingora-books
UPLOAD_MAX_MB=50
MAX_PAGES=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lingora.app
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_LIMIT=0
TASK_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
