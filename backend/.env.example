# === Lingora backend environment (copy to backend/.env) ===
# NEVER commit real values. See docs/DEPLOYMENT.md for full instructions.

APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string-openssl-rand-hex-32

# --- Database ---
# Local dev (zero setup):
DATABASE_URL=sqlite:///./data/lingora.db
# Production (Supabase -> Project Settings -> Database -> Connection string / pooler):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
# Supabase Storage option (private bucket "lingora-books" must exist):
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key   # server-only, never expose to frontend!
# SUPABASE_STORAGE_BUCKET=lingora-books

# --- Uploads ---
UPLOAD_MAX_MB=50
MAX_PAGES=300

# --- AI provider (choose ONE; leave AI_PROVIDER=none to run without AI) ---
AI_PROVIDER=none
# AI_PROVIDER=openai_compatible        # OpenAI / Groq / OpenRouter / vLLM / Ollama
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1   # or https://api.groq.com/openai/v1 etc.
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-sonnet-latest
# AI_PROVIDER=gemini
# AI_API_KEY=...
# AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_LIMIT=0

# --- Background tasks ---
TASK_BACKEND=inline
# TASK_BACKEND=celery
# REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Plan limits (subscription-ready; MVP is free) ---
FREE_MAX_BOOKS=3
PRO_MAX_BOOKS=25
PREMIUM_MAX_BOOKS=100
FREE_AI_CALLS_PER_DAY=20
PRO_AI_CALLS_PER_DAY=300
PREMIUM_AI_CALLS_PER_DAY=2000

# --- SMTP (optional, enables real password-reset emails) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@lingora.app
FRONTEND_URL=http://localhost:3000
